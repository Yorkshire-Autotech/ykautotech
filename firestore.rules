rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == 'yorkshireautotech@outlook.com'
          || request.auth.token.admin == true
        );
    }

    // Booking writes are performed only by Cloudflare Pages Functions using the
    // service account. Browser clients may not read or write customer records.
    match /bookings/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Quote enquiries from the contact form: anyone can submit one
    // (must be "new"), but they are hidden — only the admin can read/change them.
    match /enquiries/{id} {
      allow create: if request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Legacy public availability markers contain no personal data. New booking
    // reservations are written only by the server, so browser clients stay read-only.
    match /availability/{id} {
      allow read: if true;
      allow write: if false;
    }

    // OAuth refresh tokens and booking configuration are server-only.
    match /settings/{id} {
      allow read, write: if false;
    }
  }
}
