rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Booking requests: anyone can submit one (must be "pending"),
    // but only the signed-in admin can read or change them.
    match /bookings/{id} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // Confirmed-slot markers: publicly readable (no personal data)
    // so the website can grey out taken slots; only admin can write.
    match /availability/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
